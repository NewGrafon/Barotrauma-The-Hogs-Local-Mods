      <RangedWeapon barrelpos="90,11" reload="0.8" spread="1" chargetime="0.025" unskilledspread="10" combatPriority="70" drawhudwhenequipped="true" crosshairscale="0.0">
        <StatusEffect type="OnUse" target="this" tags="recoil_lock" duration="0.15" stackable="false" setvalue="true" disabledeltatime="true" />
        <StatusEffect type="OnSecondaryUse" target="this" showtexts="true" interval="2" duration="2.1" MedicalSkillBonus="15" setvalue="true" comparison="and">
          <Conditional hasstatustag="med-scan" />
          <RequiredItems items="med-scan" type="Contained" />
        </StatusEffect>
        <StatusEffect type="OnUse" target="This" maxrechargespeed="-1" delay="0.1" disabledeltatime="true" />
        <!-- Crosshairs. -->
        <Crosshair texture="%ModDir%/Crosshairs-2.png" sourcerect="256,512,256,256" />
        <CrosshairPointer texture="%ModDir%/Crosshairs-2.png" sourcerect="0,512,256,256" />
        <!-- Particles. -->
        <!-- Visible only on air. -->
        <ParticleEmitter particle="largemuzzleflash" particleamount="1" />
        <ParticleEmitter particle="muzzlelight" particleamount="1" scalemultiplier="6,4" colormultiplier="255,255,100,175" CopyEntityAngle="true" />
        <ParticleEmitter particle="muzzlelight" particleamount="1" scalemultiplier="16,12" colormultiplier="215,215,215,100" CopyEntityAngle="true" />
        <ParticleEmitter particle="largegunsmoke" particleamount="1" />
        <ParticleEmitter particle="swirlysmoke" particleamount="1" CopyEntityAngle="true" scalemultiplier="1,1" colormultiplier="100,100,100,255" />
        <!-- Visible only inside water. -->
        <ParticleEmitter particle="underwatermuzzle" particleamount="1" velocitymin="0" velocitymax="0" scalemultiplier="2.5,2.5" />
        <ParticleEmitter particle="muzzlebubbles" particleamount="6" anglemin="30" anglemax="80" velocitymin="20" velocitymax="50" />
        <ParticleEmitter particle="gunbubbles" particleamount="12" anglemin="170" anglemax="180" velocitymin="10" velocitymax="20" distancemin="0" distancemax="90" />
        <!-- Fire sounds. -->
        <Sound file="Content/Items/Weapons/GrenadeLauncherShot1.ogg" type="OnUse" frequencymultiplier="1.2" range="1000" />
        <Sound file="Content/Items/Weapons/GrenadeLauncherShot2.ogg" type="OnUse" frequencymultiplier="1.2" range="1000" />
        <Sound file="Content/Items/Weapons/GrenadeLauncherShot3.ogg" type="OnUse" frequencymultiplier="1.2" range="1000" />
        <!-- On fire, sets the light component's transparency to 255 and then back to 0.
      Why? Simply turning the light on and off is too slow. -->
        <!-- Unskilled high recoil. -->
        <StatusEffect type="OnUse" target="This" offset="0,-5">
          <Conditional targetcontainer="true" skillrequirement="true" weapons="lt 60" />
          <Explosion range="150.0" force="3" shockwave="false" smoke="false" flames="false" sparks="false" underwaterbubble="false" flash="false" applyfireeffects="false" camerashake="12.0" />
        </StatusEffect>
        <!-- Skilled low recoil. -->
        <StatusEffect type="OnUse" target="This" offset="0,-5">
          <Conditional targetcontainer="true" skillrequirement="true" weapons="gte 60" />
          <Explosion range="150.0" force="2" shockwave="false" smoke="false" flames="false" sparks="false" underwaterbubble="false" flash="false" applyfireeffects="false" camerashake="6.0" />
        </StatusEffect>
        <!-- OnBroken (when condition is set to 0 from OnInserted status effects in Containable intended for reloading animation),
      Proxy item's condition will be set to 0 and back to 100 after a delay. -->
        <StatusEffect type="OnBroken" target="Contained" targetidentifiers="grenreloading" delay="0.01" condition="0" setvalue="true" />
        <StatusEffect type="OnBroken" target="Contained" targetidentifiers="grenreloading" delay="4" condition="100" setvalue="true" />
        <!-- Fail safe if the players save and quit during the reloading or shooting. Sets the gun's values to default. -->
        <StatusEffect Type="Always" OneShot="True" target="Contained" targetidentifiers="grenereloading" condition="100" setvalue="true" />
        <StatusEffect Type="Always" OneShot="True" target="This" holdpos="40,-30" aimpos="45,0" handle1="0,-10" handle2="50,-5" holdangle="-25" aimangle="0" setvalue="true" />
        <StatusEffect type="Always" OneShot="True" targetitemcomponent="LightComponent" target="This" lightcolor="255,255,75,0" setvalue="true" />
        <StatusEffect type="Always" OneShot="True" targetitemcomponent="ItemContainer" target="This" AllowAccess="true" setvalue="true" />
        <!-- Gun requires ammo to use. -->
        <RequiredItems items="grenade" type="Contained" />
        <!-- Gun requires proxy item to use. During the reloading, the proxy item's condition is set to 0, preventing the item from firing. -->
        <RequiredItems items="grenreloading" type="Contained" />
        <RequiredSkill identifier="weapons" level="60" />
      </RangedWeapon>
      <!--Holds six grenades at a time-->
      <ItemContainer capacity="1" maxstacksize="1" hideitems="false" ShowTotalStackCapacityInContainedStateIndicator="true" showcontainedstateindicator="false" containedstateindicatorstyle="bullet" containedspritedepth="0.56">
        <Containable items="grenade" hide="true">
          <StatusEffect type="OnInserted" target="NearbyItems" range="5" targetidentifiers="weapons-up" Stackable="false" setvalue="true" disabledeltatime="true">
            <Remove />
          </StatusEffect>
          <StatusEffect type="OnInserted" target="Contained" condition="100">
            <Conditional condition="lt 100" />
          </StatusEffect>
          <StatusEffect type="OnInserted" target="This" AllowAccess="false" NonInteractable="true" delay="0.01" setvalue="true"></StatusEffect>
          <!-- Unhides the slots, allowing the person from adding more or removing. -->
          <StatusEffect type="OnInserted" target="This" AllowAccess="true" delay="3" NonInteractable="false" setvalue="true"></StatusEffect>
          <!-- Reloading animation, with status effects setting the conditions to trigger brokensprites, changing aimposes and aimangles and such. -->
          <!-- Pull down the launcher. -->
          <StatusEffect type="OnInserted" target="This" holdangle="-40" aimangle="-40" holdpos="35,-15" aimpos="30,-25" condition="0" setvalue="true" delay="0.01" allowwhenbroken="true"></StatusEffect>
          <!-- Set the hand to open the cylinder. -->
          <StatusEffect type="OnInserted" target="This" handle2="15,10" setvalue="true" delay="0.5" allowwhenbroken="true"></StatusEffect>
          <!-- Sound. -->
          <StatusEffect type="OnInserted" target="This" delay="0.9" allowwhenbroken="true">
            <Sound file="%ModDir%/GrenadeLauncher-single/GrenadeLauncher-singleCylinderOpen.ogg" frequencymultiplier="1.2" range="1000" />
          </StatusEffect>
          <StatusEffect type="OnInserted" target="This" delay="1" stackable="false" conditionalcomparison="and" allowwhenbroken="true">
            <Conditional maxrechargespeed="99" />
            <Sound file="%ModDir%/Model29/Model29RoundEjecting.ogg" range="600" frequencymultiplier="0.6" />
            <SpawnItem identifier="40mmgrenade-casing" spawnposition="This" aimspread="20" rotationtype="This" rotation="210" count="1" Impulse="0.03" />
          </StatusEffect>
          <!-- Hand opens the cylinder. -->
          <StatusEffect type="OnInserted" target="This" handle2="15,30" setvalue="true" delay="1" allowwhenbroken="true">
            <ParticleEmitter particle="gunbubbles" particleamount="5" anglemin="180" anglemax="200" velocitymin="10" velocitymax="20" distancemin="-30" distancemax="30" />
          </StatusEffect>
          <!-- Animation frame. -->
          <StatusEffect type="OnInserted" target="This" condition="33" hideitems="true" setvalue="true" delay="1.1" allowwhenbroken="true"></StatusEffect>
          <!-- Pull the hand back. -->
          <StatusEffect type="OnInserted" target="This" handle2="50,-5" setvalue="true" delay="1.4" allowwhenbroken="true"></StatusEffect>
          <!-- Smooth hand movement to new handle1 position -->
          <StatusEffect type="OnInserted" target="This" handle1="-26,8" delay="1.55" allowwhenbroken="true"></StatusEffect>
          <StatusEffect type="OnInserted" target="This" handle1="-22,12" delay="1.6" allowwhenbroken="true"></StatusEffect>
          <StatusEffect type="OnInserted" target="This" handle1="-16,18" delay="1.65" allowwhenbroken="true"></StatusEffect>
          <StatusEffect type="OnInserted" target="This" handle1="-10,22" delay="1.7" allowwhenbroken="true"></StatusEffect>
          <StatusEffect type="OnInserted" target="This" handle1="-5,26" delay="1.75" allowwhenbroken="true"></StatusEffect>
          <!-- Main handle1 position -->
          <StatusEffect type="OnInserted" target="This" handle1="0,30" holdangle="-50" aimangle="-50" holdpos="35,5" aimpos="30,-20" setvalue="true" delay="1.9" allowwhenbroken="true"></StatusEffect>
          <!-- Sound. -->
          <StatusEffect type="OnInserted" target="This" delay="2" allowwhenbroken="true">
            <Sound file="%ModDir%/GrenadeLauncher-single/GrenadeLauncher-singleGrenadeIn.ogg" frequencymultiplier="1.2" range="1000" />
            <ParticleEmitter particle="gunbubbles" particleamount="2" anglemin="180" anglemax="200" velocitymin="10" velocitymax="20" distancemin="-5" distancemax="5" />
          </StatusEffect>
          <!-- Pull down the launcher. -->
          <StatusEffect type="OnInserted" target="This" holdangle="-40" aimangle="-40" holdpos="35,-15" aimpos="30,-25" setvalue="true" delay="2.5" allowwhenbroken="true"></StatusEffect>
          <!-- Close the cylinder. -->
          <StatusEffect type="OnInserted" target="This" setvalue="true" delay="2.4" allowwhenbroken="true">
            <Sound file="%ModDir%/GrenadeLauncher-single/GrenadeLauncher-singleCylinderClose.ogg" range="1000" />
            <ParticleEmitter particle="gunbubbles" particleamount="3" anglemin="180" anglemax="200" velocitymin="10" velocitymax="20" distancemin="-30" distancemax="30" />
          </StatusEffect>
          <StatusEffect type="OnInserted" target="This" handle1="0,30" setvalue="true" delay="2.55" allowwhenbroken="true" />
          <StatusEffect type="OnInserted" target="This" handle1="0,26" handle2="15,25" setvalue="true" delay="2.58" allowwhenbroken="true" />
          <StatusEffect type="OnInserted" target="This" handle1="0,22" setvalue="true" delay="2.61" allowwhenbroken="true" />
          <StatusEffect type="OnInserted" target="This" handle1="0,18" setvalue="true" delay="2.64" allowwhenbroken="true" />
          <StatusEffect type="OnInserted" target="This" handle1="0,14" setvalue="true" delay="2.67" allowwhenbroken="true" />
          <StatusEffect type="OnInserted" target="This" handle1="0,10" setvalue="true" delay="2.70" allowwhenbroken="true" />
          <StatusEffect type="OnInserted" target="This" handle1="0,6" setvalue="true" delay="2.73" allowwhenbroken="true" />
          <StatusEffect type="OnInserted" target="This" handle1="0,2" setvalue="true" delay="2.76" allowwhenbroken="true" />
          <StatusEffect type="OnInserted" target="This" handle1="0,-2" setvalue="true" delay="2.79" allowwhenbroken="true" />
          <StatusEffect type="OnInserted" target="This" handle1="0,-6" setvalue="true" delay="2.82" allowwhenbroken="true" />
          <StatusEffect type="OnInserted" target="This" hideitems="false" holdpos="30,-30" aimpos="35,0" condition="100" maxrechargespeed="100" handle1="0,-10" handle2="50,-5" holdangle="-25" aimangle="0" setvalue="true" delay="2.9" allowwhenbroken="true" />
          <StatusEffect type="OnRemoved" target="This">
            <Sound file="%ModDir%/Saunds/BulletDetach.ogg" frequencymultiplier="0.6" range="600" volume="0.5" loop="false" />
          </StatusEffect>
        </Containable>
        <SlotIcon slotindex="0" texture="Content/UI/StatusMonitorUI.png" sourcerect="448,448,64,64" origin="0.5,0.5" />
        <SlotIcon slotindex="1" texture="Content/UI/StatusMonitorUI.png" sourcerect="320,448,64,64" origin="0.5,0.5" />
        <SubContainer capacity="1" maxstacksize="1">
          <Containable items="flashlight,flare,alienflare,glowstick" hide="false" itempos="30,1" setactive="true" />
        </SubContainer>
        <SubContainer capacity="1" maxstacksize="1">
          <Containable items="acog_scope,thermal_scope,colim_scope,brite_scope" hide="false" setactive="true" itempos="5,18">
            <StatusEffect type="OnInserted" target="Contained" delay="1">
              <Sound file="%ModDir%/Saunds/attach.ogg" range="300" volume="0.5" loop="false" />
            </StatusEffect>
            <StatusEffect type="OnInserted" target="This" handle2="10,25" AllowAccess="false" noninteractable="true" setvalue="true" />
            <StatusEffect type="OnInserted" target="Contained" spritecolor="255,255,255,0" delay="0.01" setvalue="true" />
            <StatusEffect type="OnInserted" target="Contained" spritecolor="255,255,255,255" delay="1" setvalue="true" />
            <StatusEffect type="OnInserted" target="This" handle2="50,-10" AllowAccess="true" noninteractable="false" crosshairscale="0.225" delay="1.5" setvalue="true" />
            <StatusEffect type="OnRemoved" target="This" setvalue="true" cameraaimoffset="0" crosshairscale="0.0" />
            <StatusEffect type="OnContaining" target="This,Contained" crosshairscale="0.225" OneShot="true" setvalue="true" />
          </Containable>
          <SlotIcon slotindex="0" texture="%ModDir%/attachments.png" origin="0.5,0.5" />
        </SubContainer>
      </ItemContainer>
      <!-- Where proxy item is located. -->
      <ItemContainer capacity="1" maxstacksize="1" hideitems="true" drawinventory="false" spawnwithid="grenreloading" removecontaineditemsondeconstruct="true">
        <Containable items="grenreloading" hide="true">
          <StatusEffect type="OnRemoved" target="Contained">
            <Remove />
          </StatusEffect>
        </Containable>
      </ItemContainer>
      <ItemContainer capacity="1" slotsperrow="1" maxstacksize="1" hideitems="true" drawinventory="false" removecontaineditemsondeconstruct="true" showcontainedstateindicator="false">
        <Containable items="weapons-up" hide="true" />
      </ItemContainer>
      <aitarget sightrange="500" soundrange="500" fadeouttime="3" />
      <Quality>
        <QualityStat stattype="ExplosionRadius" value="0.1" />
        <QualityStat stattype="ExplosionDamage" value="0.1" />
      </Quality>
      <Upgrade gameversion="0.10.0.0" scale="0.5" />
      <SkillRequirementHint identifier="weapons" level="60" />
