      <Body width="5" height="5" density="25" />
      <Holdable canBeCombined="true" slots="Any,RightHand,LeftHand" handle1="0,0" msg="ItemMsgPickUpSelect" />
    </Item>
    <Item allowsellingwhenbroken="true" name=" " identifier="Revolver-handle" maxstacksize="1" scale="0.5" category="Weapon" NonInteractable="True" hideinmenus="true" tags="smallitem">
      <Sprite texture="Content/Items/Weapons/weapons_new.png" sourcerect="1950,282,17,6" depth="0.55" origin="0.5,0.5" />
      <Body width="5" height="5" density="25" />
      <Holdable canBeCombined="true" slots="LeftHand" msg="ItemMsgPickUpSelect">
        <StatusEffect type="Always" target="This" delay="0.6" holdangle="50" holdpos="43,-10" handle1="-20,-10" aimangle="50" aimpos="40,20" />
        <StatusEffect type="Always" target="This" delay="1.4">
          <Remove />
