          <ParticleEmitter particle="swirlysmoke" particleamount="1" CopyEntityAngle="true" scalemultiplier="1.25,1.25" distance="20" Angle="11" colormultiplier="200,200,200,225" />
          <ParticleEmitter particle="muzzlelight" particleamount="1" scalemultiplier="6,3" colormultiplier="255,255,100,175" distance="20" Angle="11" CopyEntityAngle="true" />
          <ParticleEmitter particle="muzzlelight" particleamount="1" scalemultiplier="12,10" colormultiplier="215,215,215,100" distance="20" Angle="11" CopyEntityAngle="true" />
          <ParticleEmitter particle="mediumgunsmoke" particleamount="1" velocitymin="80" velocitymax="100" CopyEntityAngle="true" distance="20" Angle="11" />
          <Sound file="%ModDir%/Revolver/Revolver.ogg" frequencymultiplier="0.7" type="OnUse" range="3500" selectionmode="Random" />
          <Sound file="%ModDir%/Revolver/Revolver-1.ogg" frequencymultiplier="0.7" type="OnUse" range="3500" />
        </StatusEffect>
        <StatusEffect type="OnUse" target="This" stackable="false" disabledeltatime="true" forceplaysounds="true">
          <Conditional HasStatusTag="suppressed" />
          <ParticleEmitter particle="swirlysmoke" particleamount="1" CopyEntityAngle="true" distance="40" Angle="11" scalemultiplier="1,0.5" colormultiplier="200,200,200,225" />
          <ParticleEmitter particle="muzzlelight" particleamount="1" scalemultiplier="1.5,1" distance="40" Angle="11" colormultiplier="255,255,100,175" CopyEntityAngle="true" />
          <ParticleEmitter particle="smallgunsmoke" particleamount="1" scalemultiplier="0.5,0.5" distance="40" Angle="11" CopyEntityAngle="true" />
          <Sound file="%ModDir%/Revolver/Revolver-sup.ogg" frequencymultiplier="0.9" type="OnUse" range="1250" selectionmode="Random" />
          <Sound file="%ModDir%/Revolver/Revolver-1-sup.ogg" frequencymultiplier="0.9" type="OnUse" range="1250" />
        </StatusEffect>
        <ParticleEmitter particle="underwatermuzzle" particleamount="1" velocitymin="0" velocitymax="0" scalemultiplier="1.5,1.5" />
        <ParticleEmitter particle="muzzlebubbles" particleamount="3" anglemin="30" anglemax="80" velocitymin="20" velocitymax="50" />
        <ParticleEmitter particle="gunbubbles" particleamount="6" anglemin="170" anglemax="180" velocitymin="10" velocitymax="20" distancemin="0" distancemax="40" />
        <StatusEffect type="OnUse" target="This">
          <Explosion range="600" structuredamage="0" itemdamage="0" smoke="false" flames="false" force="0" sparks="false" shockwave="false" underwaterbubble="false" camerashake="0" flash="false" playtinnitus="false">
            <Affliction identifier="tinnitus_shot" strength="30" />
          </Explosion>
          <Conditional HasStatusTag="neq suppressed" />
        </StatusEffect>
        <StatusEffect type="OnUse" target="This">
          <Conditional targetcontainer="true" skillrequirement="true" weapons="lt 45" />
          <Explosion range="150.0" force="4" shockwave="false" smoke="false" flames="false" sparks="false" underwaterbubble="false" camerashake="20.0" />
        </StatusEffect>
        <StatusEffect type="OnUse" target="This">
          <Conditional targetcontainer="true" skillrequirement="true" weapons="gte 45" />
          <Explosion range="150.0" force="2" shockwave="false" smoke="false" flames="false" sparks="false" underwaterbubble="false" camerashake="6.0" />
        </StatusEffect>
        <StatusEffect type="OnUse" target="This" condition="66" delay="0.01" setvalue="true" forceplaysounds="true">
          <Sound file="%ModDir%/Revolver/RevolverCylinderRotate.ogg" range="600" volume="0.5" />
        </StatusEffect>
        <StatusEffect type="OnDeath" target="This" aimangle="0" delay="0.15" condition="66" setvalue="true"></StatusEffect>
        <StatusEffect type="OnUse" target="This" delay="0.45" condition="99" setvalue="true" conditionalcomparison="and">
          <Conditional condition="100" />
        </StatusEffect>
        <StatusEffect type="OnUse" target="This" delay="0.45" condition="98" setvalue="true" conditionalcomparison="and">
          <Conditional condition="99" />
        </StatusEffect>
        <StatusEffect type="OnUse" target="This" delay="0.45" condition="97" setvalue="true" conditionalcomparison="and">
          <Conditional condition="98" />
        </StatusEffect>
        <StatusEffect type="OnUse" target="This" delay="0.45" condition="96" setvalue="true" conditionalcomparison="and">
          <Conditional condition="97" />
        </StatusEffect>
        <StatusEffect type="OnUse" target="This" delay="0.45" condition="95" setvalue="true" conditionalcomparison="and">
          <Conditional condition="96" />
        </StatusEffect>
        <StatusEffect type="OnUse" target="This" delay="0.45" condition="94" setvalue="true" conditionalcomparison="and">
          <Conditional condition="95" />
        </StatusEffect>
        <StatusEffect type="OnUse" target="This" delay="0.45" condition="100" setvalue="true" />
        <StatusEffect type="OnBroken" target="Contained" targetidentifiers="revreloading" delay="0.01" condition="0" setvalue="true" />
        <StatusEffect type="OnBroken" target="Contained" targetidentifiers="revreloading" delay="2.1" condition="100" setvalue="true" />
        <StatusEffect Type="Always" OneShot="True" target="Contained" targetidentifiers="revreloading" condition="100" setvalue="true" />
        <StatusEffect Type="Always" OneShot="True" target="This,Contained" noninteractable="false" aimpos="70,0" handle1="-30,-10" aimangle="0" holdpos="0,0" holdangle="0" condition="100" setvalue="true" />
        <StatusEffect Type="Always" OneShot="True" targetitemcomponent="ItemContainer" target="This" delay="0.05" AllowAccess="true" noninteractable="false" setvalue="true" />
        <RequiredItems items="mapleround,maplefmjround,mapleapround" type="Contained" />
        <RequiredItems items="revreloading" type="Contained" />
        <RequiredItems items="repair" type="Contained" />
