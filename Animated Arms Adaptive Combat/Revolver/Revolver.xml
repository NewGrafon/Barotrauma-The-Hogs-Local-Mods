        <StatusEffect type="OnUse" target="Contained" targetidentifiers="repair" condition="-4.125">
          <Conditional inwater="false" />
          <Use />
        </StatusEffect>
        <StatusEffect type="OnUse" target="Contained" targetidentifiers="repair" condition="-6.125">
          <Conditional inwater="true" />
          <Use />
        </StatusEffect>
      </RangedWeapon>
      <ItemContainer capacity="4" maxstacksize="1" slotsperrow="2" hideitems="false" ShowTotalStackCapacityInContainedStateIndicator="true" itempos="100000,100000" spawnwithid="repair,laser-proxy" showcontainedstateindicator="false" containedstateindicatorstyle="bullet">
        <SlotIcon slotindex="0" texture="Content/UI/StatusMonitorUI.png" sourcerect="256,448,64,64" origin="0.5,0.5" />
        <SlotIcon slotindex="1" texture="Content/UI/StatusMonitorUI.png" sourcerect="256,448,64,64" origin="0.5,0.5" />
        <SlotIcon slotindex="2" texture="Content/UI/StatusMonitorUI.png" sourcerect="256,448,64,64" origin="0.5,0.5" />
        <SlotIcon slotindex="3" texture="Content/UI/StatusMonitorUI.png" sourcerect="256,448,64,64" origin="0.5,0.5" />
        <SlotIcon slotindex="4" texture="Content/UI/StatusMonitorUI.png" sourcerect="256,448,64,64" origin="0.5,0.5" />
        <SlotIcon slotindex="5" texture="Content/UI/StatusMonitorUI.png" sourcerect="256,448,64,64" origin="0.5,0.5" />
        <SlotIcon slotindex="6" texture="Content/UI/StatusMonitorUI.png" sourcerect="256,448,64,64" origin="0.5,0.5" />
        <Containable items="mapleround,maplefmjround,mapleapround">
          <!-- Hides the slots, preventing the person from adding more or removing. -->
          <StatusEffect type="OnInserted" target="This,Character,Contained" AllowAccess="false" noninteractable="true" delay="0.014" setvalue="true"></StatusEffect>
          <!-- Unhides the slots, allowing the person from adding more or removing. -->
          <StatusEffect type="OnInserted" target="This,Character,Contained" AllowAccess="true" noninteractable="false" delay="2.38" setvalue="true"></StatusEffect>
          <!-- Reloading animation, with status effects setting the conditions to trigger brokensprites, changing aimposes and aimangles and such. -->
          <!-- Pull down the Revolver. -->
          <StatusEffect type="OnInserted" target="This" holdangle="-20" holdpos="35,-20" aimangle="-20" aimpos="45,-15" condition="0" setvalue="true" delay="0.014" allowwhenbroken="true" stackable="false">
            <SpawnItem identifiers="Revolver-handle" spawnposition="SameInventory" spawnifcantbecontained="false" SpawnIfInventoryFull="false" />
          </StatusEffect>
          <!-- Open the Revolver. -->
          <StatusEffect type="OnInserted" target="This" delay="0.56" condition="1" setvalue="true" allowwhenbroken="true" stackable="false">
            <ParticleEmitter particle="gunbubbles" particleamount="3" anglemin="180" anglemax="200" velocitymin="10" velocitymax="20" distancemin="-20" distancemax="20" />
          </StatusEffect>
          <!-- Revolver opening sound. -->
          <StatusEffect type="OnInserted" target="This" delay="0.42" forceplaysounds="true" allowwhenbroken="true">
            <Sound file="%ModDir%/Revolver/RevolverCylinderRotate.ogg" range="1000" volume="1" />
          </StatusEffect>
          <!-- Pull up the Revolver. -->
          <StatusEffect type="OnInserted" target="This" holdangle="40" holdpos="20,-40" aimangle="40" aimpos="35,10" setvalue="true" delay="0.63" allowwhenbroken="true" stackable="false"></StatusEffect>
          <StatusEffect type="OnInserted" target="This" holdangle="80" holdpos="20,-40" aimangle="80" aimpos="35,10" setvalue="true" delay="0.98" allowwhenbroken="true" stackable="false"></StatusEffect>
          <!-- The casings fall. -->
          <!-- Several status effects with only one triggered.
			If condition is 100, first status effect is triggered, with no Revolver round ejecting sound nor any casing particles.
			If condition is 94, the seveth status effect is triggered with Revolver round ejecting sound and 6 casing particles. -->
          <StatusEffect type="OnInserted" target="This" delay="1.12" forceplaysounds="true" stackable="false" conditionalcomparison="and" allowwhenbroken="true">
            <Conditional condition="eq 100" />
            <Sound file="%ModDir%/Revolver/RevolverRoundEjecting.ogg" range="600" />
          </StatusEffect>
          <StatusEffect type="OnInserted" target="This" delay="1.12" forceplaysounds="true" stackable="false" conditionalcomparison="and" allowwhenbroken="true">
            <Conditional condition="eq 99" />
            <Sound file="%ModDir%/Revolver/RevolverRoundEjecting.ogg" range="600" />
            <SpawnItem identifier="mapleround-casing" spawnposition="This" aimspread="20" rotationtype="This" rotation="165" count="1" Impulse="0.05" />
          </StatusEffect>
          <StatusEffect type="OnInserted" target="This" delay="1.12" forceplaysounds="true" stackable="false" conditionalcomparison="and" allowwhenbroken="true">
            <Conditional condition="eq 98" />
            <Sound file="%ModDir%/Revolver/RevolverRoundEjecting.ogg" range="600" />
            <SpawnItem identifier="mapleround-casing" spawnposition="This" aimspread="20" rotationtype="This" rotation="165" count="2" Impulse="0.05" />
          </StatusEffect>
          <StatusEffect type="OnInserted" target="This" delay="1.12" forceplaysounds="true" stackable="false" conditionalcomparison="and" allowwhenbroken="true">
            <Conditional condition="eq 97" />
            <Sound file="%ModDir%/Revolver/RevolverRoundEjecting.ogg" range="600" />
            <SpawnItem identifier="mapleround-casing" spawnposition="This" aimspread="20" rotationtype="This" rotation="165" count="3" Impulse="0.05" />
          </StatusEffect>
          <StatusEffect type="OnInserted" target="This" delay="1.12" forceplaysounds="true" stackable="false" conditionalcomparison="and" allowwhenbroken="true">
            <Conditional condition="eq 96" />
            <Sound file="%ModDir%/Revolver/RevolverRoundEjecting.ogg" range="600" />
            <SpawnItem identifier="mapleround-casing" spawnposition="This" aimspread="20" rotationtype="This" rotation="165" count="4" Impulse="0.05" />
          </StatusEffect>
          <StatusEffect type="OnInserted" target="This" delay="1.12" forceplaysounds="true" stackable="false" conditionalcomparison="and" allowwhenbroken="true">
            <Conditional condition="eq 95" />
            <Sound file="%ModDir%/Revolver/RevolverRoundEjecting.ogg" range="600" />
            <SpawnItem identifier="mapleround-casing" spawnposition="This" aimspread="20" rotationtype="This" rotation="165" count="5" Impulse="0.05" />
          </StatusEffect>
          <StatusEffect type="OnInserted" target="This" delay="1.12" forceplaysounds="true" stackable="false" conditionalcomparison="and" allowwhenbroken="true">
            <Conditional condition="eq 94" />
            <Sound file="%ModDir%/Revolver/RevolverRoundEjecting.ogg" range="600" />
            <SpawnItem identifier="mapleround-casing" spawnposition="This" aimspread="20" rotationtype="This" rotation="165" count="6" Impulse="0.05" />
          </StatusEffect>
          <!-- A failsafe. -->
          <StatusEffect type="OnInserted" target="This" delay="1.12" forceplaysounds="true" stackable="false" conditionalcomparison="and" allowwhenbroken="true">
            <Conditional condition="lt 94" />
            <Sound file="%ModDir%/Revolver/RevolverRoundEjecting.ogg" range="600" />
          </StatusEffect>
          <StatusEffect type="OnInserted" target="This" holdangle="40" holdpos="20,-40" aimangle="30" aimpos="45,-15" setvalue="true" delay="0" allowwhenbroken="true" stackable="false"></StatusEffect>
          <!-- Pull down the Revolver to insert the rounds. -->
          <StatusEffect type="OnInserted" target="This" holdangle="-20" holdpos="35,-10" aimangle="-20" aimpos="45,-15" setvalue="true" delay="1.54" allowwhenbroken="true" stackable="false"></StatusEffect>
          <!-- Round insert sound. -->
          <StatusEffect type="OnInserted" target="This" delay="1.68" forceplaysounds="true" allowwhenbroken="true" stackable="false">
            <ParticleEmitter particle="gunbubbles" particleamount="3" anglemin="180" anglemax="200" velocitymin="10" velocitymax="20" distancemin="-30" distancemax="30" stackable="false" />
            <Sound file="%ModDir%/Revolver/RevolverLoading.ogg" range="600" />
          </StatusEffect>
          <!-- Aim the Revolver. -->
          <StatusEffect type="OnInserted" target="This" holdpos="0,0" aimangle="0" aimpos="70,10" delay="2.1" condition="33" setvalue="true" allowwhenbroken="true" forceplaysounds="true" stackable="false"></StatusEffect>
          <!-- Last animation stage. -->
          <StatusEffect type="OnInserted" target="This" delay="2.38" holdangle="0" holdpos="0,0" condition="100" setvalue="true" allowwhenbroken="true" stackable="false"></StatusEffect>
          <StatusEffect type="OnRemoved" target="This">
            <Sound file="%ModDir%/Saunds/BulletDetach.ogg" frequencymultiplier="0.85" range="600" volume="0.5" loop="false" />
          </StatusEffect>
        </Containable>
        <SubContainer capacity="1" maxstacksize="1">
          <Containable items="suppressor_pistol,compensator_pistol,hider_pistol" hide="false" itempos="35,8.5">
            <StatusEffect type="OnInserted" forceplaysounds="true" target="Contained" delay="0.5">
              <Sound file="%ModDir%/Saunds/attach.ogg" range="300" volume="0.5" loop="false" />
            </StatusEffect>
            <StatusEffect type="OnInserted" target="This" tag="suppressed"></StatusEffect>
          </Containable>
          <SlotIcon slotindex="0" texture="%ModDir%/attachments-1.png" origin="0.5,0.5" />
        </SubContainer>
        <SubContainer capacity="1" maxstacksize="1" hideinmenus="true">
          <Containable items="repair" hide="true">
            <StatusEffect type="OnRemoved" target="Contained">
              <Remove />
            </StatusEffect>
          </Containable>
        </SubContainer>
      </ItemContainer>
      <!-- Where proxy item is located. -->
      <ItemContainer capacity="1" slotsperrow="1" maxstacksize="1" hide="true" drawinventory="false" spawnwithid="revreloading" removecontaineditemsondeconstruct="true">
        <!-- RemoveContainedItemsOnDeconstruct removes proxy on deconstruction. -->
        <Containable items="revreloading" hide="true">
          <StatusEffect type="OnRemoved" target="Contained">
            <Remove />
          </StatusEffect>
        </Containable>
      </ItemContainer>
      <aitarget sightrange="2000" soundrange="5000" fadeouttime="5" />
